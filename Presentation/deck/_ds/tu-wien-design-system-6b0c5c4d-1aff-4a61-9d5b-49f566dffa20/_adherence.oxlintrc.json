{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/slide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgendaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|level|number|dimmed|key|ref|className|style|children)$/]",
        "message": "<AgendaItem> doesn't accept that prop. Declared props: text, level, number, dimmed."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|level|bold|bullet|key|ref|className|style|children)$/]",
        "message": "<BulletItem> doesn't accept that prop. Declared props: text, level, bold, bullet."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|unit|lines|phone|email|website|key|ref|className|style|children)$/]",
        "message": "<ContactBlock> doesn't accept that prop. Declared props: name, unit, lines, phone, email, website."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyrightNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<CopyrightNote> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyrightNote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:inverse)$/]",
        "message": "<CopyrightNote> tone must be one of 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|totalRow|variant|caption|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, totalRow, variant, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|width|base|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, height, width, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|mark)$/]",
        "message": "<Logo> variant must be one of 'full' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, attribution."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|logo|footer|pageNumber|image|base|key|ref|className|style|children)$/]",
        "message": "<Slide> doesn't accept that prop. Declared props: variant, logo, footer, pageNumber, image, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|compact|accent|photo|blank)$/]",
        "message": "<Slide> variant must be one of 'default' | 'compact' | 'accent' | 'photo' | 'blank'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slide'] > JSXAttribute[name.name='logo'] > Literal[value!=/^(?:full|mark|none)$/]",
        "message": "<Slide> logo must be one of 'full' | 'mark' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideBody'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|columns|gap|x|y|width|height|key|ref|className|style|children)$/]",
        "message": "<SlideBody> doesn't accept that prop. Declared props: variant, columns, gap, x, y, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideBody'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|compact)$/]",
        "message": "<SlideBody> variant must be one of 'default' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|pageNumber|bare|key|ref|className|style|children)$/]",
        "message": "<SlideFooter> doesn't accept that prop. Declared props: text, pageNumber, bare."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|key|ref|className|style|children)$/]",
        "message": "<SlideTitle> doesn't accept that prop. Declared props: variant, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|compact|hero|quote)$/]",
        "message": "<SlideTitle> variant must be one of 'default' | 'compact' | 'hero' | 'quote'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:inverse)$/]",
        "message": "<SlideTitle> tone must be one of 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrlLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|align|key|ref|className|style|children)$/]",
        "message": "<UrlLockup> doesn't accept that prop. Declared props: href, children, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrlLockup'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<UrlLockup> align must be one of 'left' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
